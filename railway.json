{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "pnpm install"
  },
  "deploy": {
    "startCommand": "node openclaw.mjs gateway --port $PORT --allow-unconfigured",
    "healthcheckPath": "/",
    "restartPolicyType": "on-failure",
    "restartPolicyMaxRetries": 10
  }
}